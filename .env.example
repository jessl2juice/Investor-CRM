# BetterMind CRM - Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Database (required for Cloud SQL / PostgreSQL) ---
# For local development with SQLite, these are not needed.
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=your_db_name

# Cloud SQL instance connection name (only for GCP deployment)
# Format: PROJECT_ID:REGION:INSTANCE_NAME
# INSTANCE_CONNECTION_NAME=my-project:us-west1:my-instance

# Cloud SQL instance name (used by deploy.sh)
# CLOUD_SQL_INSTANCE=bettermind-crm-db

# --- Authentication ---
# Secret key for signing JWT tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
TOKEN_SECRET=replace_with_a_random_64_char_hex_string

# --- Server ---
# Port to run on (Cloud Run sets this automatically)
# PORT=8080
